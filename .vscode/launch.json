{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CodeGates Server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/run_server.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "HOST": "0.0.0.0",
                "PORT": "8000",
                "RELOAD": "false",
                "LOG_LEVEL": "debug"
            },
            "python": "/Users/roshinpv/Documents/next/gates/.venv/bin/python",
            "justMyCode": false,
            "stopOnEntry": false
        },
        {
            "name": "Debug with Reload",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/run_server.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "HOST": "0.0.0.0",
                "PORT": "8000",
                "RELOAD": "true",
                "LOG_LEVEL": "debug"
            },
            "python": "/Users/roshinpv/Documents/next/gates/.venv/bin/python",
            "justMyCode": false,
            "stopOnEntry": false
        },
        {
            "name": "Debug Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "python": "/Users/roshinpv/Documents/next/gates/.venv/bin/python",
            "justMyCode": false
        }
    ]
}

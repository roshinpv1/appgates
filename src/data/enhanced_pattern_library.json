{
  "version": "2.0",
  "metadata": {
    "description": "Enhanced pattern library with NFR-based configuration",
    "author": "CodeGates Team",
    "created": "2024-01-01",
    "features": [
      "Criteria-based NFR mapping",
      "AND/OR/NOT logic support",
      "File & code pattern evaluation",
      "Scoring with weights per NFR",
      "Technology-specific mappings",
      "Category-based configuration"
    ]
  },
  "gates": {
    "Alerting_1.1": {
      "display_name": "All alerting is actionable",
      "description": "Ensure alerts are actionable, tuned, and remove noise",
      "category": "Alerting",
      "priority": "High",
      "weight": 12.0,
      "expected_coverage": {
        "percentage": 20,
        "reasoning": "Alert definitions should exist in monitoring configs",
        "confidence": "High",
        "max_files_expected": 20
      },
      "criteria": {
        "operator": "AND",
        "conditions": [
          {
            "name": "alert_definitions",
            "type": "file_pattern",
            "operator": "OR",
            "weight": 5.0,
            "file_patterns": [
              {"pattern": ".*alert.*\\.yml", "weight": 3.0},
              {"pattern": ".*prometheus.*\\.yml", "weight": 3.0},
              {"pattern": ".*grafana.*\\.json", "weight": 3.0}
            ]
          },
          {
            "name": "alert_keywords",
            "type": "pattern",
            "operator": "OR",
            "weight": 4.0,
            "patterns": [
              {"pattern": "threshold", "weight": 2.0},
              {"pattern": "trigger", "weight": 2.0},
              {"pattern": "severity", "weight": 2.0}
            ]
          }
        ]
      }
    },

